generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime? @map("email_verified")
  image               String?
  locale              String    @default("en")
  onboarding_complete Boolean   @default(false)
  created_at          DateTime  @default(now())
  accounts            Account[]
  sessions            Session[]
  children            Child[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Child {
  id            String    @id
  parent_id     String?
  name          String
  name_he       String?
  avatar_emoji  String
  avatar_color  String    @default("#f06449")
  share_code    String?   @unique
  date_of_birth DateTime?
  is_public     Boolean   @default(false)
  created_at    DateTime  @default(now())
  parent        User?     @relation(fields: [parent_id], references: [id])
  follows       Follow[]
}

model Follower {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  created_at DateTime  @default(now())
  follows    Follow[]
}

model Follow {
  id               String    @id @default(cuid())
  follower_id      String
  child_id         String
  created_at       DateTime  @default(now())
  last_notified_at DateTime?
  follower         Follower  @relation(fields: [follower_id], references: [id], onDelete: Cascade)
  child            Child     @relation(fields: [child_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, child_id])
}

model Reaction {
  id         String   @id @default(cuid())
  artwork_id String
  user_type  String   // "parent" | "follower"
  user_id    String
  emoji      String
  created_at DateTime @default(now())

  @@unique([artwork_id, user_type, user_id])
}

model Comment {
  id          String    @id @default(cuid())
  artwork_id  String
  user_type   String    // "parent" | "follower"
  user_id     String
  author_name String
  text        String
  approved    Boolean   @default(true)
  created_at  DateTime  @default(now())
  deleted_at  DateTime?
}

model Challenge {
  id             String                @id @default(cuid())
  title          String
  title_he       String
  description    String
  description_he String
  emoji          String
  category       String                // "colors" | "shapes" | "nature" | "family" | "imagination" | "technique"
  difficulty     String                // "easy" | "medium" | "adventure"
  week_start     DateTime
  week_end       DateTime
  active         Boolean               @default(true)
  created_at     DateTime              @default(now())
  submissions    ChallengeSubmission[]
}

model ChallengeSubmission {
  id           String    @id @default(cuid())
  challenge_id String
  child_id     String
  artwork_id   String
  created_at   DateTime  @default(now())
  challenge    Challenge @relation(fields: [challenge_id], references: [id])

  @@unique([challenge_id, child_id])
}

model Insights {
  id                    String   @id @default(cuid())
  child_id              String
  analysis_period       String   // e.g. "March 2026"
  tags                  String   // JSON-serialized string[]
  sentiment             String   // e.g. "Joyful", "Calm", "Energetic"
  milestone_detected    String   // free text developmental observation
  top_interest          String   // "obsession of the month"
  growth_tip            String   // Celebrate & Stretch recommendation
  encouragement_scripts String   // JSON-serialized string[]
  visual_evolution      Json     // { color_diversity: number, line_confidence: string, subject_complexity: string }
  thematic_focus        Json     // { subjects: Record<string, number> }
  created_at            DateTime @default(now())

  @@unique([child_id, analysis_period])
}

model ArtworkAnalysis {
  id                 String    @id @default(cuid())
  artwork_id         String    @unique
  child_id           String
  image_url          String
  thumb_url          String?   // 400px thumbnail (null for seeded/external images)
  title              String?   // optional parent-supplied title
  status             String    @default("analyzed") // "pending" | "analyzed"
  analysis_date      DateTime  @default(now())
  predominant_colors String    // JSON-serialized string[]
  main_subjects      String    // JSON-serialized string[]
  technique_notes    String
  ai_tags            String    // JSON-serialized string[]
  emotional_tone     String    @default("Joyful")
  deleted_at         DateTime? // soft delete
}

model FamilyInvite {
  id         String   @id @default(cuid())
  email      String
  kid_id     String
  invited_by String   // user id of the parent who sent it
  status     String   @default("pending") // "pending" | "accepted" | "declined"
  created_at DateTime @default(now())

  @@map("family_invites")
}

model Points {
  id           String   @id @default(cuid())
  user_id      String   @unique
  total_points Int      @default(0)
  tier         String   @default("Budding Artist") // "Budding Artist" | "Creative Explorer" | "Star Curator" | "Master Guardian"
  created_at   DateTime @default(now())

  @@map("points")
}

model PointsHistory {
  id            String   @id @default(cuid())
  user_id       String
  action        String   // "upload" | "invite" | "challenge" | "encourage" | "add_kid" | "streak"
  points_earned Int
  description   String
  created_at    DateTime @default(now())

  @@map("points_history")
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  discount_percent Int       @default(100) // 100 = free
  max_uses         Int
  current_uses     Int       @default(0)
  active           Boolean   @default(true)
  expires_at       DateTime?
  created_at       DateTime  @default(now())

  @@map("promo_codes")
}

model UserSubscription {
  id            String   @id @default(cuid())
  user_id       String   @unique
  plan          String   @default("free") // "free" | "pro" | "family"
  promo_code_id String?  // which PromoCode was used (null if paid via Stripe)
  created_at    DateTime @default(now())

  @@map("user_subscriptions")
}
